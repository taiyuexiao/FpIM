# backend 配置模板 —— 复制为 backend/.env 后填入真实值
# ⚠️ .env 已被 .gitignore 排除，本文件只放占位符，禁止写入真实凭据
# 说明：口令也可由 PGPASSWORD 提供（libpq 自动读取），此时 DATABASE_URL 可省略口令部分

DATABASE_URL=postgresql://swzr_admin:CHANGE_ME@localhost:5432/shouwenzeren_newdb
PGPASSWORD=CHANGE_ME
# 生成方式：openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
BCRYPT_ROUNDS=12
# agent-service 地址(AGUI 事件代理转发目标)
AGENT_SERVICE_URL=http://127.0.0.1:8100

# IM 附件存储根目录(本地磁盘,内容寻址)
FPIM_FILE_ROOT=/data/fpim/files

# 开发/测试用：种子账号统一登录口令（conftest 与 scripts/fpim_smoke_*.py 读取）
SEED_PASSWORD=CHANGE_ME

# 邮件草稿(DeepSeek,OpenAI 兼容接口);未配置 key 时草稿自动降级为模板
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# SMTP 发信（PASSWORD 为邮箱授权码,非登录密码）
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=首问必答平台

# IMAP 收信（与 SMTP 同一邮箱授权码;MAIL_POLL_SECONDS=0 关闭收信）
IMAP_HOST=imap.163.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
MAIL_POLL_SECONDS=0
