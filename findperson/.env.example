# 前端联调配置模板 —— 复制为 .env 后按需修改
# ⚠️ .env 已被 .gitignore 排除；本文件只放占位符，禁止写入真实凭据
# 注：本文件同时也是 docker compose 的变量来源（读 DB_PASSWORD）

# 业务接口:backend 分支 FastAPI(人员/部门/内容/评价/会话/认证)
VITE_API_MODE=server
VITE_API_BASE_URL=http://127.0.0.1:8001/api/v1
# 问答 AGUI:agent-service(SSE 事件流)
VITE_AGUI_MODE=server
VITE_AGUI_BASE_URL=http://127.0.0.1:8100/api/agui

# 登录页「快捷登录」演示账号口令；不设置则不显示快捷登录
VITE_DEMO_PASSWORD=

# docker compose 建 PG 容器用（见 docker-compose.yml 的 POSTGRES_PASSWORD）
DB_PASSWORD=
