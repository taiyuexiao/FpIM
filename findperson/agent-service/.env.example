# ===== LLM(DeepSeek OpenAI 兼容) =====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1/chat/completions
LLM_MODEL=deepseek-chat
LLM_USE_MOCK=0
LLM_TIMEOUT_MS=30000

# ===== Embedding =====
# provider: mock(离线链路验证) / fastembed(本地 ONNX,≤1024 维) / openai_compatible(生产)
EMBEDDING_USE_MOCK=0
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_BASE_URL=        # 如 https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=         # 由密钥管理注入,禁止入库
EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIM=1536     # RAG 空间固定 1536,与 knowledge-service 对齐
RAG_EMBEDDING_MODEL=text-embedding-v4
CONCEPT_EMBEDDING_DIM=512  # Concept 内部空间
CONCEPT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ===== PostgreSQL =====
PGHOST=localhost
PGPORT=5432
PGDATABASE=shouwenzeren_agent
PGUSER=postgres
PGPASSWORD=
LEGACY_PGDATABASE=shouwenzeren

# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8100

# ===== OKF 仓库 =====
OKF_REPO_DIR=knowledge-okf

# ===== MCP =====
MCP_USE_MOCK=0
MCP_TIMEOUT_MS=3000

# ===== 反馈回流 =====
FEEDBACK_RANK_WEIGHT=0.1   # 排序微调上限;0 关闭回流
