# ── 系统 ──
.DS_Store
Thumbs.db

# ── 编辑器 / IDE ──
.idea/
.vscode/
*.swp

# ── 依赖与构建产物（findperson/ 内部另有 .gitignore，这里是兜底）──
node_modules/
dist/
build/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ── 环境变量（含数据库口令，不入库）──
.env
.env.local
*.log

# ── 运行时产物 ──
/tmp-files/
findperson/.vite/

# ===== ↑ 以上同步自 .gitignore（「从 .gitignore 同步」只重写以上部分）=====
.git/
.hg/
.svn/
bower_components/
jspm_packages/
site-packages/
coverage/
htmlcov/
lcov-report/
cmakefiles/
cmake-build-*/
bazel-*/
pods/
deriveddata/
storybook-static/
playwright-report/
test-results/
allure-results/
allure-report/
cdk.out/
*.dist-info/
eggs/
pip-wheel-metadata/
wheels/
